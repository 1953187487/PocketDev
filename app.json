{
  "expo": {
    "name": "PocketDev",
    "slug": "pocketdev",
    "version": "1.0.7",
    "orientation": "portrait",
    "scheme": "pocketdev",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/brand/icon.png",
    "backgroundColor": "#080B16",
    "android": {
      "package": "com.pocketdev.app",
      "versionCode": 8,
      "minSdkVersion": 26,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0B1020"
      },
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "ios": {
      "bundleIdentifier": "com.pocketdev.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#080B16",
          "dark": {
            "backgroundColor": "#060912",
            "image": "./assets/brand/splash-icon.png"
          }
        }
      ],
      "expo-sharing",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
